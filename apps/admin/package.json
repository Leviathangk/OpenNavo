{
  "name": "@opennavo/admin",
  "private": true,
  "version": "2.2.0",
  "description": "OpenNavo administration app, based on soybean-admin with Vue, Vite, TypeScript, NaiveUI, and UnoCSS.",
  "keywords": [
    "TypeScript",
    "UnoCSS",
    "Vite7",
    "Vue3 admin ",
    "ant-design-vue v4",
    "naive-ui",
    "naive-ui-admin",
    "vue-admin-template"
  ],
  "homepage": "https://github.com/soybeanjs/soybean-admin",
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-admin/issues"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-admin.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "fmt": "oxfmt",
    "gen-route": "sa gen-route",
    "lint": "oxlint && eslint .",
    "preview": "vite preview",
    "release": "sa release",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "dev:mock": "VITE_SERVICE_BASE_URL=http://localhost:4011 vite --mode test",
    "e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@fontsource-variable/inter": "catalog:",
    "@iconify/vue": "catalog:",
    "@opennavo/api": "workspace:*",
    "@opennavo/shared": "workspace:*",
    "@opennavo/tokens": "workspace:*",
    "@opennavo/ui": "workspace:*",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "clipboard": "2.0.11",
    "dayjs": "1.11.20",
    "defu": "6.1.7",
    "echarts": "6.1.0",
    "json5": "2.2.3",
    "naive-ui": "2.44.1",
    "nprogress": "0.2.0",
    "pinia": "catalog:",
    "tailwind-merge": "3.6.0",
    "vue": "catalog:",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.2",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@playwright/test": "catalog:",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "catalog:",
    "@types/node": "catalog:",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/test-utils": "catalog:",
    "consola": "3.4.2",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "kolorist": "1.8.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sass": "1.99.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "catalog:",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-vue-devtools": "8.1.2",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  },
  "website": "https://admin.soybeanjs.cn"
}
