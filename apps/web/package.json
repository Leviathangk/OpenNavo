{
  "name": "@opennavo/web",
  "version": "0.0.0",
  "private": true,
  "description": "OpenNavo web app (Nuxt 4 SSR)",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "dev:mock": "NUXT_PUBLIC_API_BASE=http://localhost:4010 NUXT_API_BASE_INTERNAL=http://localhost:4010 nuxt dev --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "node ../../tooling/scripts/lint-frontend.mjs --eslint",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:ssr": "node --test tests/ssr-seo.test.mjs tests/cache-cleanup.test.mjs",
    "dev:e2e": "NUXT_PUBLIC_API_BASE=${E2E_API_BASE:-http://127.0.0.1:18082/api/v1} NUXT_API_BASE_INTERNAL=${E2E_API_BASE:-http://127.0.0.1:18082/api/v1} nuxt dev --port ${E2E_WEB_PORT:-3000}",
    "e2e": "playwright test",
    "gen:og-font": "node scripts/og-font.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@nuxtjs/seo": "catalog:",
    "@opennavo/api": "workspace:*",
    "@opennavo/shared": "workspace:*",
    "@opennavo/tokens": "workspace:*",
    "@opennavo/ui": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@unocss/reset": "catalog:",
    "ioredis": "catalog:",
    "nuxt": "catalog:",
    "satori": "catalog:",
    "unstorage": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@lhci/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@unocss/nuxt": "catalog:",
    "jsdom": "catalog:",
    "subset-font": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
