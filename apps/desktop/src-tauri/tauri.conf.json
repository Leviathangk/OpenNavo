{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNavo",
  "version": "0.0.0",
  "identifier": "com.opennavo.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "python3 scripts/prepare-bundle-helpers.py"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "OpenNavo",
        "width": 1400,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "backgroundColor": "#131313"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://cdn.opennavo.com https://*.mzstatic.com; connect-src 'self' ipc: http://ipc.localhost https://api.opennavo.com https://cdn.opennavo.com; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost http://localhost:9000 https://cdn.opennavo.com https://*.mzstatic.com; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:4010 http://localhost:8080 https://api.opennavo.com https://cdn.opennavo.com; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/com.opennavo.desktop/icons/**", "$APPDATA/logs/local-app-icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/askpass/opennavo-askpass", "resources/third-party/**/*"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "files": {
        "Helpers/opennavo-store": "../native/staged/opennavo-store",
        "Library/LaunchDaemons/org.opennavo.desktop.FanHelper.plist": "fan-helper/org.opennavo.desktop.FanHelper.plist",
        "Library/Helpers/opennavo-fan-helper": "fan-helper/staged/opennavo-fan-helper",
        "Library/Helpers/clamav/clamd": "../native/staged/clamav/clamd",
        "Library/Helpers/clamav/freshclam": "../native/staged/clamav/freshclam",
        "Library/Helpers/clamav/clamscan": "../native/staged/clamav/clamscan",
        "Library/Helpers/clamav/clamav.crt": "../native/staged/clamav/clamav.crt"
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["opennavo"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1MjBGMTM4Q0Q5ODdDNkUKUldSdWZKak5PUEVnVmZnQ2lzN0ZKUXVpdThIWFlpUEdidmdxSC9vekNCOElpMElURmVZSEFFTDMK",
      "endpoints": ["https://cdn.opennavo.com/desktop/stable/latest.json"]
    }
  }
}
