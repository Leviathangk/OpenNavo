#!/bin/sh
# Copy comes from Rust language resources and is passed only as arguments; only sudo reads passwords.
# The HOMEBREW_ prefix keeps the copy through bin/brew's environment filter when brew runs sudo.
: "${HOMEBREW_OPENNAVO_ASKPASS_MESSAGE:?}" "${HOMEBREW_OPENNAVO_ASKPASS_TITLE:?}" "${HOMEBREW_OPENNAVO_ASKPASS_OK:?}" "${HOMEBREW_OPENNAVO_ASKPASS_CANCEL:?}"
exec /usr/bin/osascript - "$HOMEBREW_OPENNAVO_ASKPASS_MESSAGE" "$HOMEBREW_OPENNAVO_ASKPASS_TITLE" "$HOMEBREW_OPENNAVO_ASKPASS_OK" "$HOMEBREW_OPENNAVO_ASKPASS_CANCEL" <<'APPLESCRIPT'
on run argv
  set r to display dialog (item 1 of argv) default answer "" with hidden answer with title (item 2 of argv) with icon caution buttons {item 4 of argv, item 3 of argv} default button (item 3 of argv) cancel button (item 4 of argv)
  return text returned of r
end run
APPLESCRIPT
