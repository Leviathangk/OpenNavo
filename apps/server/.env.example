# For isolated local development only; inject production secrets through the environment.
APP_ENV=dev
HTTP_ADDR=:8080
# Forwarded headers are untrusted by default; configure only controlled proxy IPs or CIDRs in deployments.
TRUSTED_PROXIES=
METRICS_ADDR=:9090
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:9527
PUBLIC_CORS_ORIGINS=http://localhost:3000,http://localhost:1420
DATABASE_URL=postgres://opennavo:opennavo-dev-only@localhost:55432/opennavo?sslmode=disable
DB_MAX_OPEN_CONNS=30
REDIS_URL=redis://localhost:56379/0
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opennavo
S3_ACCESS_KEY=opennavo-dev
S3_SECRET_KEY=opennavo-dev-only
S3_USE_SSL=false
CDN_BASE_URL=http://localhost:9000/opennavo
JWT_SECRET=opennavo-local-development-only-placeholder
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h
# Admin PAT encryption; empty derives a purpose-specific key from JWT_SECRET. api/worker must match.
GITHUB_SETTINGS_ENCRYPTION_KEY=
# SEO credential encryption (IndexNow key, Cloudflare purge token); empty derives a purpose-specific key from JWT_SECRET. api/worker must match.
SEO_SETTINGS_ENCRYPTION_KEY=
# URL change feed: the web's internal port (cache invalidation) and a shared secret (32+ bytes). Without the secret, page caches expire by TTL.
WEB_INTERNAL_URL=
WEB_INTERNAL_SECRET=
# OpenAI-compatible gateway URL; empty uses https://api.openai.com/v1. Override locally in .env.local.
# Admin credential encryption; empty derives a purpose-specific key from JWT_SECRET. api/worker must match. Re-encrypt or clear stored credentials before rotation.
# Admin settings control content translation budgets; monetary limits below apply only to calls not configured through admin.
HOMEBREW_API_BASE=https://formulae.brew.sh/api
FETCH_USER_AGENT=OpenNavoBot/1.0 (+https://opennavo.example/bot)
CI_RELEASE_TOKEN=
ADMIN_BOOTSTRAP_USERNAME=local-admin
ADMIN_BOOTSTRAP_PASSWORD=local-development-only
E2E_ADMIN_PASSWORD=opennavo-e2e-dev-only
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
TZ_SCHEDULE=Asia/Shanghai
# Explicit Traditional Chinese backfill command after a converter upgrade: objects derived again per second, derived rows written per minute.
TRADITIONAL_BACKFILL_OBJECTS_PER_SECOND=20
TRADITIONAL_BACKFILL_WRITES_PER_MINUTE=30

# The catalog supports Cask only; other values prevent startup.
CATALOG_KINDS=cask

# Internal Agent entry point; generate at least 32 bytes for deployment. Empty rejects all Agent requests.
AGENT_GATEWAY_SECRET=

# Optional dedicated disposable cache instance; blank retains local development behavior.
CACHE_REDIS_URL=

# Optional trusted HTTPS observation-link base; empty exposes IDs only. No credentials or query.
GEO_OBSERVATION_BASE_URL=

# Only ingress peers that overwrite CF-IPCountry using trusted edge geolocation.
# Keep empty without this ingress guarantee; usage country then remains ZZ (unknown).
# Example documentation network only: USAGE_COUNTRY_TRUSTED_PROXIES=192.0.2.10/32
USAGE_COUNTRY_TRUSTED_PROXIES=
