{
	{$CADDY_GLOBAL_OPTIONS}
}

# Diagnostic only. Enable after approval and verification that this site's Cloudflare rule
# overwrites this header with true/false on EVERY request. No access/rate-limit exemption.
# remote_ip uses the connection peer, never XFF/CF-Connecting-IP. Do not enable with an
# unverified intermediary or PROXY protocol listener which can replace that peer address.
# Public Cloudflare ranges checked 2026-10-20: https://www.cloudflare.com/ips-v4/ and /ips-v6/.
# Changes require review/reload, not request-time network lookups. Unknown peers fail closed.
(verified-bot-ingress) {
	@botVerificationDisabled expression `{env.OPENNAVO_CF_VERIFIED_BOT_ENABLED} != 'true'`
	request_header @botVerificationDisabled -X-OpenNavo-Verified-Bot
	@botNotCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @botNotCloudflare -X-OpenNavo-Verified-Bot
	# Preserve the original values for trusted peers: Nitro must reject duplicates/invalid values.
	# Only Cloudflare may say where a visitor is: API usage stats and the web consent check read CF-IPCountry.
	request_header @botNotCloudflare -CF-IPCountry
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' {$PUBLIC_BASE_URL}; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}

# Web pages allow GA4 and the optional GEOInflow origin configured by the operator. The
# script only runs once the visitor's region or consent allows it; API and admin keep the policy above.
(security-web) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com {$GEOINFLOW_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' {$PUBLIC_BASE_URL} https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com {$GEOINFLOW_ORIGIN}; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}

{$WEB_DOMAIN} {
	import verified-bot-ingress
	@internalAgent path /agent-api /agent-api/*
	handle @internalAgent {
		respond 404
	}
	import security-web
	encode zstd gzip
	reverse_proxy {
		dynamic a {
			name web-proxy
			port 3000
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
	}
}

{$API_DOMAIN} {
	import verified-bot-ingress
	@internalAgent path /agent-api /agent-api/*
	handle @internalAgent {
		respond 404
	}
	# The package sitemap feed is the web server's snapshot source, read over the internal network (api-ssr). One page
	# costs seconds of database work, so the public host does not serve it.
	@internalSitemap path /api/v1/sitemap/packages
	handle @internalSitemap {
		respond 404
	}
	import security
	encode zstd gzip
	@public path /api/* /healthz /readyz
	handle @public {
		reverse_proxy {
			dynamic a {
				name api-proxy
				port 8080
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}
	handle {
		respond 404
	}
}

{$ADMIN_DOMAIN} {
	import verified-bot-ingress
	@internalAgent path /agent-api /agent-api/*
	handle @internalAgent {
		respond 404
	}
	import security
	encode zstd gzip
	@oauth path /oauth/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
	handle @oauth {
		reverse_proxy {
			dynamic a {
				name api-proxy
				port 8080
				refresh 10s
			}
		}
	}
	handle /mcp {
		request_body {
			max_size 2MB
		}
		reverse_proxy mcp-proxy:8790 {
			flush_interval -1
			header_up -X-Agent-Gateway-Key
			header_up -X-Agent-Client-IP
		}
	}
	@mcpOther path /mcp/* /healthz
	handle @mcpOther {
		respond 404
	}
	handle /admin-api/* {
		reverse_proxy {
			dynamic a {
				name api-proxy
				port 8080
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
