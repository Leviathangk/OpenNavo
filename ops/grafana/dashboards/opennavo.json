{
  "uid": "opennavo-operations",
  "title": "OpenNavo",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),0.001)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(job,status)(sync_runs_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queues",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(queue,state) (asynq_queue_size)",
          "legendFormat": "{{queue}} · {{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Catalog",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(kind)(catalog_packages)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(task,type)(llm_tokens_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM duration",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,max by(le,task)(rate(llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM cost USD",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(llm_cost_usd_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GitHub",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(github_ratelimit_remaining)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Changelog",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(source,status)(changelog_fetch_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Claimed crawler families at origin",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(agent,verification,verification_basis)(rate(opennavo_web_requests_total{agent!~\"browser|unknown|self_test\"}[5m]))",
          "legendFormat": "{{agent}} · {{verification}} / {{verification_basis}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Crawler final errors and redirects at origin",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(agent,status,verification,verification_basis)(rate(opennavo_web_requests_total{agent!~\"browser|unknown|self_test\",status!~\"200|304\"}[5m]))",
          "legendFormat": "{{agent}} {{status}} · {{verification}} / {{verification_basis}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Claimed crawler route types at origin",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,verification,verification_basis)(rate(opennavo_web_requests_total{agent!~\"browser|unknown|self_test\"}[5m]))",
          "legendFormat": "{{route}} · {{verification}} / {{verification_basis}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "text",
      "title": "About crawler counts",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "mode": "markdown",
        "content": "Counts cover only requests that reached Nitro, using the final HTTP status (including origin cache hits). Cloudflare cache hits and edge blocks are absent: edge coverage is unavailable without separate edge data; never add origin and edge totals or infer per-URL coverage. Agent labels are UA claims, not authenticated engine identities. verified / cf_client_bot means a trusted, sanitized ingress forwarded Cloudflare known-good-bot classification; it does not verify Googlebot or any other named vendor. ua_only means a crawler claim without that attestation; unknown means no crawler classification. false is not a malicious verdict. Verification is disabled by default and never grants an access exemption. Meta ExternalAgent mixes training and indexing; Google/Apple Extended are policy tokens, not separate fetchers. self_test (OpenNavo-Probe/Test UA) is excluded from these graphs and remains a UA claim, not evidence of natural discovery or citation. GA4 measures visitors separately."
      }
    }
  ]
}
