{
  "uid": "opennavo-operations",
  "title": "OpenNavo",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),0.001)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(job,status)(sync_runs_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queues",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asynq_queue_size",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Catalog",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(kind)(catalog_packages)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(task,type)(llm_tokens_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM duration",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,max by(le,task)(rate(llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM cost USD",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(llm_cost_usd_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM budget",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(llm_month_tokens)/max(llm_month_token_budget)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GitHub",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(github_ratelimit_remaining)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Changelog",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(source,status)(changelog_fetch_total)",
          "legendFormat": "{{job}} {{kind}} {{task}} {{type}} {{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Crawlers at origin",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(agent)(rate(opennavo_web_requests_total{agent!~\"browser|unknown\"}[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Crawler errors and redirects",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(agent,status)(rate(opennavo_web_requests_total{agent!~\"browser|unknown\",status!~\"200|304\"}[5m]))",
          "legendFormat": "{{agent}} {{status}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Crawled page types",
      "datasource": {
        "type": "prometheus",
        "uid": "opennavo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route)(rate(opennavo_web_requests_total{agent!~\"browser|unknown\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "text",
      "title": "About crawler counts",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "mode": "markdown",
        "content": "Counts cover requests that reached the web origin. Pages served from the Cloudflare cache never get here, so use Cloudflare analytics for total crawler traffic. User-agents can be forged: confirm important crawlers against the vendors' published IP ranges or reverse DNS. Visitors are measured in GA4, which does not see crawlers and misses visitors in mainland China and users with ad blockers."
      }
    }
  ]
}
