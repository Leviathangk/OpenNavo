# Set real domains, images, and secrets only in the deployment environment; do not commit configuration copies.
WEB_DOMAIN=opennavo.example
API_DOMAIN=api.opennavo.example
ADMIN_DOMAIN=admin.opennavo.example
PUBLIC_BASE_URL=https://api.opennavo.example
WEB_BASE_URL=https://opennavo.example
# Compose injects the same site address into web; both runtime variables must match.
NUXT_PUBLIC_SITE_URL=${WEB_BASE_URL}
NUXT_PUBLIC_I18N_BASE_URL=${WEB_BASE_URL}
ADMIN_ORIGIN=https://admin.opennavo.example
PUBLIC_CORS_ORIGINS=
CDN_BASE_URL=https://cdn.opennavo.example
# Optional: the CDN's bucket as the web container reaches it (e.g. http://minio:9000/opennavo), so
# share images read icons there instead of through the public CDN.
CDN_BASE_URL_INTERNAL=
SERVER_IMAGE=ghcr.io/opennavo/opennavo-server:server-v0.0.0
OPS_IMAGE=ghcr.io/opennavo/opennavo-ops:server-v0.0.0
WEB_IMAGE=ghcr.io/opennavo/opennavo-web:web-v0.0.0
MCP_IMAGE=ghcr.io/opennavo/opennavo-mcp:mcp-v0.1.0
# At least 32 bytes; inject only into api/mcp and never commit it.
AGENT_GATEWAY_SECRET=
ADMIN_DIST=/srv/opennavo/admin
# Generate a stable random value and keep it only in the deployment environment; do not commit it.
NUXT_OG_IMAGE_SECRET=
DATABASE_URL=
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
REDIS_URL=redis://redis:6379/0
# Optional outside Compose; public query caches only. Invalidation stays on REDIS_URL.
CACHE_REDIS_URL=redis://web-cache:6379/1
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=opennavo
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
JWT_SECRET=
CI_RELEASE_TOKEN=
GITHUB_SETTINGS_ENCRYPTION_KEY=
SEO_SETTINGS_ENCRYPTION_KEY=
WEB_INTERNAL_SECRET=
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CONCURRENCY=8
LLM_RPM=120
LLM_MONTHLY_TOKEN_BUDGET=30000000
LLM_MONTHLY_BUDGET_USD=0
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Dedicated Caddy-to-API/web network; the fixed address must be inside the subnet and outside the dynamic pool.
CADDY_PROXY_SUBNET=172.30.80.0/24
CADDY_PROXY_IP_RANGE=172.30.80.128/25
CADDY_PROXY_IP=172.30.80.2
# SSR forwarding network joined only by web/API.
SSR_PROXY_SUBNET=172.30.81.0/24

# Hardened optional database and monitor images, built from apps/server/Dockerfile.
POSTGRES_IMAGE=opennavo-postgres:local
ASYNQMON_IMAGE=opennavo-asynqmon:local
REDIS_IMAGE=opennavo-redis:local
CADDY_IMAGE=opennavo-caddy:local
