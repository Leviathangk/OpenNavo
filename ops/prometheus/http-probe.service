[Unit]
Description=OpenNavo origin and edge HTTP probes
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/opennavo-monitoring/http-probe.py /opt/opennavo-monitoring/probes.json
Restart=always
RestartSec=10
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CPUQuota=10%
MemoryMax=96M

[Install]
WantedBy=multi-user.target
