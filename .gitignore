# Secrets: never commit.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.p12
*.key
# soybean-admin mode files (.env.test / .env.prod contain no secrets and must be committed).
!apps/admin/.env
!apps/admin/.env.test
!apps/admin/.env.prod

# System and editor files.
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies and build outputs.
node_modules/
dist/
# Token outputs must be committed; CI verifies they match their sources.
!packages/tokens/dist/
# Admin Vite configuration sources: explicitly allow them so a developer's global build/ ignore does not hide them.
!apps/admin/build/
.output/
.nuxt/
.nitro/
coverage/
playwright-report/
test-results/
.lighthouseci/
apps/desktop/src-tauri/target/
# Capability schemas generated by Tauri builds.
apps/desktop/src-tauri/gen/
apps/server/bin/
*.log

# Local runtime artifacts, such as AI-exported review tables.
apps/server/tmp/

# Tool caches.
__pycache__/
.pnpm-store/
.cache/
*.tsbuildinfo

# Internal development material excluded from the open-source repository.
/.codex/
/docs/*
# Public documentation; other internal material under docs remains excluded.
!/docs/i18n/
/docs/i18n/*
!/docs/i18n/README.zh-CN.md
!/docs/i18n/README.ja-JP.md
!/docs/i18n/README.es-ES.md
!/docs/i18n/README.pt-BR.md
!/docs/i18n/README.ru-RU.md
!/docs/i18n/README.de-DE.md
!/docs/i18n/README.fr-FR.md
!/docs/i18n/README.it-IT.md
!/docs/i18n/README.zh-Hant.md
!/docs/security/
/docs/security/*
!/docs/security/DEPENDENCY_SECURITY.md
!/docs/legal/
!/docs/design/
/docs/design/*
!/docs/design/logo/
/AGENTS.md
/CLAUDE.md
/docs/design/opennavo-mockups.html
/docs/design/screens/

# Staged native executables are rebuilt from locked sources.
/apps/desktop/native/staged/
